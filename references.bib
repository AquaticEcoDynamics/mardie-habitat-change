@article{Silva2020,
   abstract = {In the initial stages of wave energy converter development, a wide range of design parameters should be tested and analyzed across all operational sea states. As a result, it is required to conduct a large number of time domain simulations that are computationally expensive. The following study presents the application of a fast and high-fidelity alternative technique, named statistical linearization (SL), that can be used for the stochastic analysis of nonlinear wave energy converters. The method consists of an approximate solution that allows one to quickly estimate the contribution of nonlinear terms using a probabilistic model. The application of the statistical linearization is demonstrated using three conceptually different wave energy converters, a point absorber, an oscillating wave surge converter, and an oscillating water column, with distinct nonlinear dynamics. The performance of SL is assessed against nonlinear time-domain simulations in terms of spatial response distributions and power spectral densities of responses and excitation loads, mean offsets, mean absorbed power and equivalent linear terms. The results show a good agreement between the two types of models for all wave energy converters considered, while showing that SL is approximately 3 to 4 orders of magnitude faster than the time domain model.},
   author = {L. S.P. Silva and N. Y. Sergiienko and C. P. Pesce and B. Ding and B. Cazzolato and H. M. Morishita},
   doi = {10.1016/j.apor.2019.102023},
   issn = {01411187},
   issue = {December 2019},
   journal = {Applied Ocean Research},
   keywords = {Nonlinear wave energy converters,Spectral domain,Statistical linearization,Stochastic analysis},
   pages = {102023},
   publisher = {Elsevier},
   title = {Stochastic analysis of nonlinear wave energy converters via statistical linearization},
   volume = {95},
   url = {https://doi.org/10.1016/j.apor.2019.102023},
   year = {2020}
}
@article{Zhong2019,
   abstract = {To facilitate the commercialization of wave energy in an array or farm environment, effective control strategies for improving energy extraction efficiency of the system are important. In this paper, we develop and apply model-predictive control (MPC) to a heaving point-absorber array, where the optimization problem is cast into a convex quadratic programming (QP) formulation, which can be efficiently solved by a standard QP solver. We introduced a term for penalizing large slew rates in the cost function to ensure the convexity of this function. Constraints on both range of the states and the input capacity can be accommodated. The convex formulation reduces the computational hurdles imposed on conventional nonlinear MPC. For illustration of the control principles, a point-absorber approximation is adopted to simplify the representation of the hydrodynamic coefficients among the array by exploiting the small devices to wavelength assumption. The energy-capturing capabilities of a two-cylinder array in regular and irregular waves are investigated. The performance of the MPC for this two-WEC array is compared to that for a single WEC, and the behavior of the individual devices in head or beam wave configuration is explained. Also shown is the reactive power required by the power takeoff system to achieve the performance.},
   author = {Qian Zhong and Ronald W. Yeung},
   doi = {10.1007/s11804-019-00081-x},
   issn = {16719433},
   issue = {1},
   journal = {Journal of Marine Science and Application},
   keywords = {Convex formulation,Model predictive control,Point-absorber approximation,Wave-energy arrays,Wave-energy conversion},
   pages = {26-37},
   title = {Model-Predictive Control Strategy for an Array of Wave-Energy Converters},
   volume = {18},
   year = {2019}
}
@article{DeChowdhury2015,
   abstract = {Theoretical, numerical and experimental studies on arrays of ocean wave energy converter are reviewed. The importance of extracting wave power via an array as opposed to individual wave-power machines has long been established. There is ongoing interest in implementing key technologies at commercial scale owing to the recent acceleration in demand for renewable energy. To date, several reviews have been published on the science and technology of harnessing ocean-wave power. However, there have been few reviews of the extensive literature on ocean wave-power arrays. Research into the hydrodynamic modelling of ocean wave-power arrays is analysed. Where ever possible, comparisons are drawn with physical scaled experiments. Some critical knowledge gaps have been found. Specific emphasis has been paid on understanding how the modelling and scaled experiments are likely to be complementary to each other.},
   author = {S De Chowdhury and JR -R. Nader and A. Madrigal Sanchez and A. Fleming and B. Winship and S. Illesinghe and A. Toffoli and A. Babanin and I. Penesis and R. Manasseh and S De Chowdhury and JR -R. Nader and S De Chowdhury and JR -R. Nader and A. Madrigal Sanchez and A. Fleming and B. Winship and S. Illesinghe and A. Toffoli and A. Babanin and I. Penesis and R. Manasseh},
   journal = {arXiv preprint arXiv: …},
   title = {A review of hydrodynamic investigations into arrays of ocean wave energy converters},
   url = {http://arxiv.org/abs/1508.00866},
   year = {2015}
}
@article{Konak2006,
   abstract = {Multi-objective formulations are realistic models for many complex engineering optimization problems. In many real-life problems, objectives under consideration conflict with each other, and optimizing a particular solution with respect to a single objective can result in unacceptable results with respect to the other objectives. A reasonable solution to a multi-objective problem is to investigate a set of solutions, each of which satisfies the objectives at an acceptable level without being dominated by any other solution. In this paper, an overview and tutorial is presented describing genetic algorithms (GA) developed specifically for problems with multiple objectives. They differ primarily from traditional GA by using specialized fitness functions and introducing methods to promote solution diversity. © 2005 Elsevier Ltd. All rights reserved.},
   author = {Abdullah Konak and David W. Coit and Alice E. Smith},
   doi = {10.1016/j.ress.2005.11.018},
   issn = {09518320},
   issue = {9},
   journal = {Reliability Engineering and System Safety},
   pages = {992-1007},
   title = {Multi-objective optimization using genetic algorithms: A tutorial},
   volume = {91},
   year = {2006}
}
@article{Mavrakos1997,
   abstract = {A comparison of methods for the calculation of the hydrodynamic characteristics of arrays of wave power devices is presented. In particular, the plane-wave approximation and an exact multiple scattering formulation have been used to compute exciting wave forces, hydrodynamic coefficients and q factors for arrays of interacting wave power devices. The results obtained are compared with each other, and accuracy aspects of the computations are stressed and critically assessed. © 1998 Elsevier Science Limited. All rights reserved.},
   author = {S. A. Mavrakos and P. McIver},
   doi = {10.1016/S0141-1187(97)00029-1},
   issn = {01411187},
   issue = {5-6},
   journal = {Applied Ocean Research},
   pages = {283-291},
   title = {Comparison of methods for computing hydrodynamic characteristics of arrays of wave power devices},
   volume = {19},
   year = {1997}
}
@article{Child2011,
   abstract = {The performance of an array of wave energy converters (WECs) may be significantly affected by a great number of parameters that are free to be chosen as part of the project design process. These include those describing the layout of WECs within the array and certain settings relating to the power take-off (PTO) of each converter. Furthermore, site- specific design constraints may be present. However, it is not clear how design variables should be set in the general case and so a need is identified for a tool that assists in the decision- making process. This paper describes the development and preliminary results from a WEC array design tool whose purpose is to determine values of critical design variables on behalf of the user through computational optimisation under a wide variety of realistic scenarios. Two formulations for calculation of the associated objective function are used: frequency-domain and time-domain. Optimisation is performed in a range of cases involving different types of WEC, constraints and objective functions in irregular seas. It is shown that array interactions can have a significant effect upon performance and furthermore that the use of constraints may be important in determining a realistic solution},
   author = {Benjamin F. M. Child and João Cruz and M. Livingstone},
   journal = {Proceedings of the Ninth European Wave and Tidal Energy Conference, EWTEC.},
   keywords = {array,optimisation,power,wave energy,wave farm},
   title = {The development of a tool for optimising arrays of wave energy converters},
   year = {2011}
}
