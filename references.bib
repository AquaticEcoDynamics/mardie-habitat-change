   publisher = {American Meteorological Society},
   title = {A Method for the Routine Analysis of Pitch-and-Roll Buoy Wave Data},
   volume = {18},
   url = {https://journals.ametsoc.org/view/journals/phoc/18/7/1520-0485_1988_018_1020_amftra_2_0_co_2.xml},
