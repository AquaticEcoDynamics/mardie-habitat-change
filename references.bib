   author = {Ian L. Turner and Christopher K. Leaman and Mitchell D. Harley and Mandi C. Thran and Daniel R. David and Kristen D. Splinter and Nashwan Matheen and Jeff E. Hansen and Michael V.W. Cuttler and Diana J.M. Greenslade and Stefan Zieger and Ryan J. Lowe},
   doi = {10.1016/j.coastaleng.2024},
