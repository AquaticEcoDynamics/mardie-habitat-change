   author = {H Kagemoto and Dick K.P. Yue},
   journal = {Journal of Fluid Mechanics},
   pages = {189-209},
   title = {Interactions among multiple three-dimensional bodies in water waves: an exact algebraic method},
   volume = {166},
   year = {1986}
