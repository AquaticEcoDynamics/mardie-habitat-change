@book{Paillard2014,
   abstract = {Renewable energy (RE) sources, such as biomass, hydraulics, thermal or photovoltaic (PV) solar energy, geothermal, terrestrial wind power and marine energies, represent a huge and limitless potential, available in all parts of the world. Technological and non-technological issues need to be resolved to allow the various industrial specialties to reach a level of technical and economic profitability, which, depending on the level of development of the area, could be achieved between 2020 and 2030. The appearance of the concept of sustainable development at the end of the 20th Century has led humanity to take into consideration, on the scale of the planet, the major challenges faced by its extraordinary expansion. The development of marine renewable energies (MRE) must contribute to two main stakes that affect the global economy of the societies: the energetic stakes and the industrial stakes.},
