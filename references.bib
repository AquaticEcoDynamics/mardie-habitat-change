@article{Kunishima2020,
   abstract = {Soft-substrate tide pools are considered important habitats for fishes from an ecological perspective. However, the ecological roles of such pools and use patterns by fish remain unclear, especially regarding differences between estuarine and coastal tidal flats. In this study, quantitative sampling using the quadrat method was performed in the estuarine and coastal tidal flats on Okinawa-jima Island of subtropical Japan during four seasons. Ecological roles of soft-substrate tide pools were classified as follows: (1) permanent habitat for residents; (2) nursery ground for transients; and (3) waiting area until high tide for accidental species. Within these classifications, the ecological role and value of tide pools for transient fishes varied between the tidal flat types. The habitat value of tide pools is higher for residents than for transient species because the habitat is not replaceable for residents because of their specific ability to survive there. By contrast, transient and accidental species use the tide pools as temporary habitats; however, their high diversity affects the variation in community structure on Okinawa-jima Island. Our results suggest that we should consider not only species diversity, but also habitat use patterns of individual species, together with their life history, when evaluating habitat value with regard to conservation and management of each tidal flat.},
   author = {Taiga Kunishima and Katsunori Tachihara},
   doi = {10.1071/MF19019},
   issn = {13231650},
   issue = {7},
   journal = {Marine and Freshwater Research},
   keywords = {habitat use,life history,nursery ground,permanent habitat,seasonal variation},
   pages = {737-749},
   title = {What ecological role do soft-substrate tide pools play for fishes? Difference in community structures between estuarine and coastal tidal flats in subtropical Japan},
   volume = {71},
   year = {2020}
}
