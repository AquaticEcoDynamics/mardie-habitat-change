@article{May1977,
   abstract = {Theory and observation indicate that natural multi-species assemblies of plants and animals are likely to possess several different equilibrium points. This review discusses how alternate stable states can arise in simple 1- and 2-species systems, and applies these ideas to grazing systems, to insect pests, and to some human host-parasite systems. © 1977 Nature Publishing Group.},
