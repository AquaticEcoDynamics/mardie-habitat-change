@article{Isdr2006,
   abstract = {The Third International Conference on Early Warning (EWC III) held in Bonn, Germany from 27-29 March 2006 provided the opportunity to present new and innovative early warning projects and to discuss natural hazards and risks around the world and how their impacts can be minimised through the implementation of people-centred early warning. The present document “Developing Early Warning Systems: A Checklist” was developed as a conference outcome, to both inform and draw upon the discussions and practical examples raised during the conference, and to support the implementation of the early warning components of the Hyogo Framework for Action.},
   author = {Isdr},
