@article{Rybak2024,
   abstract = {Artificial geothermal water systems are an efficient and low-cost alternative to natural ecosystems for phototrophic microorganism biomass production on an industrial scale. Our study focused on the investigation of mat-forming cyanobacteria produced in an artificial pool with a geothermal water source from a hot spring in Uniejów, Poland. The microorganisms inhabiting this ecosystem tolerate the high salinity (approximately 50 ‰) and temperature (45-55.2 °C) of the water. The structure, composition, and growth rates of the cyanobacterial mats were investigated under natural and laboratory conditions. We tested whether cyanobacteria harvested from this habitat represent a safe source of vital biomolecules for industrial applications. We found that the layered mats consisted of simple filamentous cyanobacteria, mainly of the genera Leptolyngbya, Thermoleptolyngbya, and Anagnostidinema. In the isolated cyanobacteria, we did not detect commonly studied cyanotoxins (i.e., ATX-a, BMAA, CYN, MC, and SXT) that could pose a direct risk to human health and lead to indirect risks through the contamination of bioproducts. The extracts and filtrates of the strains did not reduce the survival of Daphnia. In addition, we found that temperatures of 40-50 °C and pH values of 7.2-7.7 were optimal for mat formation and the growth of the dominant cyanobacteria. In the case of the Desertifilum dzianense strain, the highest biomass yield was noted at 26 °C. In summary, our study indicates that mat-forming cyanobacteria inhabiting ecosystems powered by geothermal waters from the Uniejów hot spring have strong potential as bioresources for different industrial applications.},
   author = {Andrzej S. Rybak and Marcin Dziuba and Aleksandra Pełechata and Michał Rybak and Sultana Akter and Anna Czerepska and Tamara Dulić and Maciej Gąbka and Alica Hindáková and Tomasz Jurczak and Aysu Kendir and Joanna Mankiewicz-Boczek and Jussi Meriluoto and Łukasz Wejnerowski},
   doi = {10.1016/J.ALGAL.2024.103646},
   issn = {2211-9264},
   journal = {Algal Research},
   keywords = {Bioproducts,Cyanotoxins,Geothermal waters,Hypersaline habitat,Microbial mats,cyanobacteria},
   month = {8},
   pages = {103646},
   publisher = {Elsevier},
   title = {Characterization of cyanobacterial mats from an artificial hot spring in Uniejów (Poland) and the potential use of their biomass},
   volume = {82},
   year = {2024}
}
@article{Demoulin2019,
   abstract = {Cyanobacteria played an important role in the evolution of Early Earth and the biosphere. They are responsible for the oxygenation of the atmosphere and oceans since the Great Oxidation Event around 2.4 Ga, debatably earlier. They are also major primary producers in past and present oceans, and the ancestors of the chloroplast. Nevertheless, the identification of cyanobacteria in the early fossil record remains ambiguous because the morphological criteria commonly used are not always reliable for microfossil interpretation. Recently, new biosignatures specific to cyanobacteria were proposed. Here, we review the classic and new cyanobacterial biosignatures. We also assess the reliability of the previously described cyanobacteria fossil record and the challenges of molecular approaches on modern cyanobacteria. Finally, we suggest possible new calibration points for molecular clocks, and strategies to improve our understanding of the timing and pattern of the evolution of cyanobacteria and oxygenic photosynthesis.},
   author = {Catherine F. Demoulin and Yannick J. Lara and Luc Cornet and Camille François and Denis Baurain and Annick Wilmotte and Emmanuelle J. Javaux},
   doi = {10.1016/J.FREERADBIOMED.2019.05.007},
   issn = {18734596},
   journal = {Free Radical Biology and Medicine},
   keywords = {Biosignatures,Cyanobacteria,Evolution,Microfossils,Molecular clocks,Precambrian},
   month = {8},
   pages = {206-223},
   pmid = {31078731},
   publisher = {Elsevier Inc.},
   title = {Cyanobacteria evolution: Insight from the fossil record},
   volume = {140},
   year = {2019}
}
@article{Wimmler2024,
   abstract = {Agent-based vegetation models are a widely used tool in ecology, for example, to understand and predict the response of vegetation to environmental change. Models are based on well-established descriptions of processes such as vegetation establishment, growth and mortality. However, they are often developed from scratch, which can be inefficient. Here we present pyMANGA, a free and open-source platform for plant growth modelers. pyMANGA's modular design allows for the combination of different concepts and theories of how plants establish, grow or compete in response to above- and below-ground resource availability. New or alternative modules describing, e.g., competition or facilitation, can be easily added. The interchangeability of modules supports the systematic testing of different hypotheses, e.g., on dominant processes in soil-plant feedback loops. Here we further present the thorough benchmarking strategy to maintain the platform and how pyMANGA can be used to compare models with different levels of abstraction and complexity.},
   author = {Marie Christin Wimmler and Jasper Bathmann and Jonas Vollhüter and Uta Berger},
   doi = {10.1016/J.ENVSOFT.2024.105973},
   issn = {1364-8152},
   journal = {Environmental Modelling \& Software},
   keywords = {Benchmarking,Building blocks,Ecological modeling,Individual-based modeling,Modularity,Reusability},
   month = {3},
   pages = {105973},
   publisher = {Elsevier},
   title = {pyMANGA: A modular, open and extendable software platform for modeling of forest and vegetation dynamics},
   volume = {174},
   year = {2024}
}
