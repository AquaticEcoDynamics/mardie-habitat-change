   year = {1984}
}
@book{Mei1983,
   abstract = {The aim of this book is to present selected theoretical topics on ocean wave dynamics, including basic principles and applications in coastal and offshore engineering, all from the deterministic point of view. The bulk of the material deals with the linearized theory, including harbour oscillations incited by incident long waves. The inviscid linearized theory is covered while frictional effects caused directly or indirectly by viscosity are treated. A special effect of breaking waves on beaches is examined and the secondary effects of nonlinearity are considered. The cases where nonlinearity is of primary importance, for shallow and deep waters are dealt with. Wave induced stresses in a porous but deformable seabed is studied. (from preface)},
   author = {Chiang C. Mei},
